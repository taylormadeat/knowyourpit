# Workspace-root EAS ignore — keeps upload lean for pnpm monorepo.
# EAS archives from workspace root for pnpm monorepos; this file
# provides exclusions at that level.

# node_modules at workspace root and in all packages
node_modules/

# Large attached assets (images/videos not needed at build time)
attached_assets/

# Other artifacts not needed for the iOS mobile build
artifacts/marketing/
artifacts/api-server/
artifacts/promo-video/
artifacts/mockup-sandbox/

# Native build artifacts (regenerated during EAS prebuild)
artifacts/knowyourpit/ios/
artifacts/knowyourpit/android/

# Expo caches
**/.expo/
**/.expo-shared/
**/.metro-cache/

# Editor / OS
.vscode/
.idea/
**/.DS_Store
**/Thumbs.db

# pnpm store (inside workspace .local/ — can be many GB)
.local/

# Git internals
.git/

# Screenshots and test outputs
screenshots/
