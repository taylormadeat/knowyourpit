# Runtime
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
BASE_PATH=

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
ALLOW_ORPHAN_DROP=false
ALLOW_PROD_DROPS=false

# Authentication
SESSION_SECRET=replace-with-a-long-random-value
CLERK_SECRET_KEY=replace-with-development-server-key
CLERK_SECRET_KEY_PROD=replace-with-production-server-key
CLERK_PUBLISHABLE_KEY=replace-with-development-publishable-key
CLERK_PROXY_URL=

# AI provider
AI_INTEGRATIONS_OPENAI_BASE_URL=https://provider.example/v1
AI_INTEGRATIONS_OPENAI_API_KEY=replace-with-server-api-key

# Object storage
PUBLIC_OBJECT_SEARCH_PATHS=
PRIVATE_OBJECT_DIR=

# RevenueCat server configuration
PAYWALL_ENABLED=true
REVENUECAT_PROJECT_ID=
REVENUECAT_SECRET_KEY=replace-with-server-api-key
REVENUECAT_APPLE_APP_STORE_APP_ID=
REVENUECAT_GOOGLE_PLAY_STORE_APP_ID=
REVENUECAT_TEST_STORE_APP_ID=
REVENUECAT_WEBHOOK_URL=https://api.example.com/api/webhooks/revenuecat
REVENUECAT_WEBHOOK_SECRET=replace-with-webhook-secret

# Email
RESEND_API_KEY=replace-with-server-api-key

# App Store Connect operations
ASC_API_KEY_ID=
ASC_API_ISSUER_ID=
ASC_API_KEY_P8=replace-with-private-key-content

# GitHub backup operations
GITHUB_PAT=replace-with-fine-grained-token
GITHUB_TOKEN=replace-with-fine-grained-token
GITHUB_REPO=owner/knowyourpit

# Mobile public configuration
# EXPO_PUBLIC_* values are compiled into the app and are not secrets.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_DOMAIN=app.example.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-development-publishable-key
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY_PROD=replace-with-production-publishable-key
EXPO_PUBLIC_CLERK_PROXY_URL=
EXPO_PUBLIC_REPL_ID=
EXPO_PUBLIC_PARTNER_BIG_PETES=false
EXPO_PUBLIC_ACTIVE_PARTNER=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DEV_ENABLED=false
EXPO_PUBLIC_REVENUECAT_IOS_KEY=replace-with-public-ios-sdk-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=replace-with-public-android-sdk-key

# Replit development preview
REPLIT_DEV_DOMAIN=
REPLIT_EXPO_DEV_DOMAIN=
REPLIT_INTERNAL_APP_DOMAIN=
REPLIT_CONNECTORS_HOSTNAME=
REPL_IDENTITY=
WEB_REPL_RENEWAL=
REPL_ID=
EXPO_BASE_URL=
EXPO_PACKAGER_PROXY_URL=
REACT_NATIVE_PACKAGER_HOSTNAME=
CI=

# Android publishing
GOOGLE_PLAY_WIF_CONFIG=replace-with-secure-workload-identity-configuration