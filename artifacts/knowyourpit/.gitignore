# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native — android is fully ignored.
android/
# ios/ contents are ignored broadly, but two specific files must be tracked:
#   - ios/knowyourpit/PrivacyInfo.xcprivacy  (Apple-required privacy manifest)
#   - ios/knowyourpit.xcodeproj/project.pbxproj  (its Xcode project registration)
# EAS builds upload the ios/ directory directly (bypassing expo prebuild), so
# these files must be committed so EAS includes them in the submitted archive.
#
# Git requires un-ignoring each parent directory in the chain before files
# inside can be negated. `ios/` (directory ignore) blocks all negations;
# `ios/*` (glob on contents) allows the step-by-step pattern below to work.
ios/*
!ios/knowyourpit/
ios/knowyourpit/*
!ios/knowyourpit/PrivacyInfo.xcprivacy
!ios/knowyourpit.xcodeproj/
ios/knowyourpit.xcodeproj/*
!ios/knowyourpit.xcodeproj/project.pbxproj
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Android Play Store credentials — never commit these
google-services.json
google-play-service-account.json

# typescript
*.tsbuildinfo
.vercel

.env
