# EAS build excludes — keep the upload archive lean.
# Reference: https://docs.expo.dev/build-reference/easignore/
#
# .easignore takes precedence over .gitignore in EAS uploads. Anything matched
# here is stripped from the archive sent to EAS, but stays in the repo locally.

# Native build artefacts (regenerated by prebuild during the EAS job)
ios/
android/

# Expo & Metro caches
.expo/
.expo-shared/
.metro-cache/

# Node tooling caches
node_modules/.cache/
.eslintcache
.tsbuildinfo

# Test directories
__tests__/
__mocks__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage/

# Documentation & repo metadata (not needed by the runtime)
*.md
docs/
LICENSE

# Editor & OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local env files (EAS injects its own secrets)
.env
.env.*
!.env.example

# Source maps from prior local builds
*.map

# Local helper scripts (submit.sh, register-app-ids.sh, build.js — not needed by EAS)
scripts/

# Local dev server used only during development
server/

# Diagnostics output
diagnostics/
