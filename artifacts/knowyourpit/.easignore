# EAS build excludes — keep the upload archive lean.
# Reference: https://docs.expo.dev/build-reference/easignore/
#
# .easignore takes precedence over .gitignore in EAS uploads. Anything matched
# here is stripped from the archive sent to EAS, but stays in the repo locally.

# Native build artefacts
# ios/ intentionally included — pre-generated Podfile with patches baked in
#   bypasses expo prebuild on EAS (which has been failing since 2026-06-14)
android/

# Expo & Metro caches
.expo/
.expo-shared/
.metro-cache/

# Node tooling caches
node_modules/.cache/
.eslintcache
.tsbuildinfo

# Test directories
__tests__/
__mocks__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage/

# Documentation & repo metadata (not needed by the runtime)
*.md
docs/
LICENSE

# Editor & OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local env files (EAS injects its own secrets)
.env
.env.*
!.env.example

# Source maps from prior local builds
*.map

# Local helper scripts (not needed by EAS)
# List each file explicitly so scripts/measure-archive-size.js remains in the
# archive and can be invoked by the eas:build:pre npm lifecycle hook.
scripts/build.js
scripts/register-app-ids.sh
scripts/submit.sh

# Local dev server used only during development
server/

# Diagnostics output
diagnostics/
