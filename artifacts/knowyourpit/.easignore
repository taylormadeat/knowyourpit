# EAS build excludes — keep the upload archive lean.
# Reference: https://docs.expo.dev/build-reference/easignore/
#
# .easignore takes precedence over .gitignore in EAS uploads. Anything matched
# here is stripped from the archive sent to EAS, but stays in the repo locally.

# Git metadata — never needed by EAS, but traversed when EAS walks up to
# the monorepo root. At 400 MB+ this is the dominant contributor to archive size.
.git/

# Native build artefacts
# ios/ intentionally included — pre-generated Podfile with patches baked in
#   bypasses expo prebuild on EAS (which has been failing since 2026-06-14)
# ios/Pods/ excluded — EAS reinstalls pods from Podfile.lock; no need to upload them
android/
ios/Pods/
ios/build/
ios/DerivedData/
ios/.xcode.env.local

# Expo & Metro caches
.expo/
.expo-shared/
.metro-cache/

# Node modules — EAS reinstalls from pnpm-lock.yaml on its own servers.
# The workspace root node_modules/ is ~1.1 GB uncompressed (~190 MB compressed)
# and the single largest contributor to archive size after .git/.
# All nested package node_modules/ are excluded by the same glob.
node_modules/
.eslintcache
.tsbuildinfo

# Test directories
__tests__/
__mocks__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage/

# Documentation & repo metadata (not needed by the runtime)
*.md
docs/
LICENSE

# Editor & OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local env files (EAS injects its own secrets)
.env
.env.*
!.env.example

# Source maps from prior local builds
*.map

# Local helper scripts (not needed by EAS)
# List each file explicitly so scripts/measure-archive-size.js remains in the
# archive and can be invoked by the eas:build:pre npm lifecycle hook.
scripts/build.js
scripts/register-app-ids.sh
scripts/submit.sh

# Local dev server used only during development
server/

# Diagnostics output
diagnostics/
